# Quesne oscillator: m(x) = (1 + x/a)^-1, V(x) = a w^2 x^2 / (8 (x + a)), a = 2, w = 1; exact E_n = (n + 1/2)/2
Verbose           = 0
Dimension         = 1
Charge            = -1.0
UseDirectSolve    = 1
EnableCAP         = 0
Polarization      = x
Domain = -1.999999999, 50.0
BoundaryType = Dirichlet
SplineDegree = 7
NQuadratures = 10
KnotSequence = uniform
NSplines = 8000
Mass = (1.0 + x/2.0)^(-1.0)
MassIsConstant = 0
Potential = x*x/(4.0*(x + 2.0))
PotentialDerivativeX = x*(x + 4.0)/(4.0*(x + 2.0)*(x + 2.0))
TargetEigenvalue = 0.25
NBoundStates = 10
EnablePropagation = 0
