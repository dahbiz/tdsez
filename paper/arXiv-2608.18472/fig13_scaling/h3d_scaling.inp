# strong scaling, 3D hydrogen: 97 cubic B-splines per axis (912 673 unknowns), hydrogenic knots on [-25, 25]^3, 100 Crank-Nicolson steps
Verbose = 1
Dimension = 3
Domain = -25, 25, -25, 25, -25, 25
SplineDegree = 3
NQuadratures = 5
KnotSequence = hydrogenic
HydrogenicInnerSpacing  = 0.1
HydrogenicInnerElements = 15
HydrogenicMaxSpacing    = 0.75
Mass = 1.0
Charge = -1.0
Potential = -1/sqrt(x^2 + y^2 + z^2)
PotentialDerivativeX = x/(x^2 + y^2 + z^2)^1.5
PotentialDerivativeY = y/(x^2 + y^2 + z^2)^1.5
PotentialDerivativeZ = z/(x^2 + y^2 + z^2)^1.5
TargetEigenvalue = -0.6
NBoundStates = 1
InitialState = ground
EnablePropagation = 1
Propagator = cn
TimeStep = 0.05
FinalTime = 5.0
EnableCAP = 1
CAPLayerWidth = 5
Polarization = z
LaserZ = 0.05*sin(pi*t/5)^2*sin(0.057*t)
OutputStrideWFS = 0
PhysicsOutput = dipole, energy
