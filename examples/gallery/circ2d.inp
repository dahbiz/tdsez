Verbose = 1
Dimension = 2
Domain = -40, 40, -40, 40
SplineDegree = 5
NQuadratures = 6
KnotSequence = uniform
NSplines = 200
Potential = -1/sqrt(x*x + y*y + 0.6363)
PotentialDerivativeX = x/(x*x + y*y + 0.6363)^1.5
PotentialDerivativeY = y/(x*x + y*y + 0.6363)^1.5
NBoundStates = 3
NBoundStatesSave = 1
TargetEigenvalue = -0.6
InitialState = ground
EnablePropagation = 1
EnableCAP = 1
CAPKmin = 0.5
Propagator = pade22
TimeStep = 0.05
FinalTime = 100
OutputStrideWFS = 20
PhysicsOutput = dipole, population, energy, wfs
Variables = E0=0.12, w=0.3, T=83.78
Polarization = xy
Omegax = 0.3
Omegay = 0.3
LaserX = t < T ? E0*sin(pi*t/T)^2*cos(w*t) : 0
LaserY = t < T ? E0*sin(pi*t/T)^2*sin(w*t) : 0
