# t-SURFF benchmark: free Gaussian wave packet in a laser pulse.
# Exact spectrum |b(k)|^2 = (2 w^2/pi)^(1/2) exp(-2 w^2 (k - k0)^2), w = 1, k0 = 2,
# for any field, mass, constant potential and charge (canonical momentum is
# conserved). SurffInterior = 1 adds the part still inside the box at FinalTime.
#
#   tdsez.x -inp free_packet_1d.inp
#   python plot_tsurff.py td/free_packet_1d_surff.h5

Dimension          = 1
Domain             = -40.0, 40.0
SplineDegree       = 7
NQuadratures       = 10
KnotSequence       = uniform
NSplines           = 400
Charge             = -1.0
Mass               = 1.0
Potential          = 0
PotentialDerivativeX = 0

NBoundStates       = 0
InitialState       = wavepacket
WavepacketCenter   = 0.0
WavepacketMomentum = 2.0
WavepacketWidth    = 1.0

Polarization       = x
LaserX             = t<20 ? 0.1*sin(pi*t/20)^2*sin(1.3*t) : 0

EnablePropagation  = 1
Propagator         = pade22
TimeStep           = 0.025
FinalTime          = 40.0
EnableCAP          = 1
CAPKmin            = 0.5
OutputStrideWFS    = 100000

TSurff             = 1
SurffInterior      = 1
SurffRadius        = 10
SurffKmin          = -1
SurffKmax          = 5
SurffNk            = 121
