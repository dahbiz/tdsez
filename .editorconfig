# -*- mode: initial ; indent-tabs-mode: t; tab-width: 4 -*-
# vim: set ft=dosini ts=4 sw=4 noexpandtab:
# EditorConfig: TDSEZ project

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.cpp]
indent_size = 4
indent_style = space

[*.hpp]
indent_size = 4
indent_style = space

[*.h]
indent_size = 4
indent_style = space

[*.py]
indent_size = 4
indent_style = space

[*.inp]
indent_size = 4
indent_style = space

[cmake/banner.cmake CMakeLists.txt]
indent_size = 4
indent_style = space

[*.sh]
indent_size = 4
indent_style = space

[docs/assets/*.js]
indent_size = 2
indent_style = space

[docs/assets/*.css]
indent_size = 2
indent_style = space

[docs/assets/*.html]
indent_size = 2
indent_style = space

[.gitignore]
trim_trailing_whitespace = false
