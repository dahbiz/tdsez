# 3D Harmonic Oscillator, m=1, omega=0.2 (all axes), smooth well-conditioned
# TDSEZ units (hbar^2/2m = 1/2, hbar=1, m=1):
#   H = -(1/2) nabla^2 + (1/2) m w^2 r^2
#   E_n = (nx + ny + nz + 1.5) * w = (n+1.5)*0.2 -> E0=0.3, E1=0.5, E2=0.7 (a.u.)
Verbose           = 0
Dimension         = 3
Domain            = -15.0, 15.0, -15.0, 15.0, -15.0, 15.0
SplineDegree      = 5
NQuadratures      = 8
KnotSequence      = uniform
NSplines          = 12
Planck            = 1.0
Charge            = 1.0
Mass              = 1.0
MassIsConstant    = 1
Potential         = 0.5 * 1.0 * 0.2 * 0.2 * (x*x + y*y + z*z)
PotentialDerivativeX = 0.2 * 0.2 * x
PotentialDerivativeY = 0.2 * 0.2 * y
PotentialDerivativeZ = 0.2 * 0.2 * z
UseDirectSolve    = 0
TargetEigenvalue  = 0.0
NBoundStates      = 7
NBoundStatesSave  = 0
EnablePropagation = 0
EnableCAP         = 0
Polarization      = x
