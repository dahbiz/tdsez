# 1D Harmonic Oscillator — VALIDATION gate: superposition beat, full period.
# Real-variant control for the complex quadrature test (ho1d_supq imagery).
# E0=0.1, E1=0.3 (omega=0.2); beat period T = 2*pi/omega = 31.41592653.
# <x>(t) = x01*cos(omega*t + phi),  x01 = sqrt(1/(2*omega)) = 1.58113883.
Verbose           = 0
Dimension         = 1
Domain            = -20.0, 20.0
SplineDegree      = 5
NQuadratures      = 8
KnotSequence      = uniform
NSplines          = 80
Charge            = 1.0
Mass              = 1.0
MassIsConstant    = 1
Potential         = 0.5 * 1.0 * 0.2 * 0.2 * x * x
PotentialDerivativeX = 0.2 * 0.2 * x
UseDirectSolve    = 0
TargetEigenvalue  = 0.0
NBoundStates      = 5
NBoundStatesSave  = 1
InitialState      = sup: 0.7071067811865476*0 + 0.7071067811865476*1
EnablePropagation = 1
TimeStep          = 0.1
FinalTime         = 31.41592653
LaserX            = 0.0*sin(0.1*t)
OutputStrideTS    = 5
Polarization      = x
EnableCAP         = 0
PhysicsOutput     = dipole,population,energy,autocorrelation
