# 1D Harmonic Oscillator — NEGATIVE VALIDATION: InitialState requests a state
# index that exceeds NBoundStates. Must be rejected by ValidateOrThrow with a
# clear message (not a silent wrong state).
Verbose           = 0
Dimension         = 1
Domain            = -20.0, 20.0
SplineDegree      = 5
NQuadratures      = 8
KnotSequence      = uniform
NSplines          = 80
Planck            = 1.0
Charge            = 1.0
Mass              = 1.0
MassIsConstant    = 1
Potential         = 0.5 * 1.0 * 0.2 * 0.2 * x * x
PotentialDerivativeX = 0.2 * 0.2 * x
UseDirectSolve    = 0
TargetEigenvalue  = 0.0
NBoundStates      = 4
NBoundStatesSave  = 0
InitialState      = state:5
EnablePropagation = 0
EnableCAP         = 0
Polarization      = x
