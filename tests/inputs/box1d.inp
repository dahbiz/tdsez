# 1D infinite square well, L=10 a.u., hard barrier walls just outside.
# Analytic (code convention hbar^2/2m = 1/2): E_n = (pi^2/2) * n^2 / L^2
#   E1 = pi^2/(2*100) = 0.049348 a.u.
Verbose           = 1
Dimension         = 1
Domain            = -5.0, 5.0
SplineDegree      = 5
NQuadratures      = 8
KnotSequence      = uniform
NSplines          = 60
Planck            = 1.0
Charge            = 1.0
Mass              = 1.0
MassIsConstant    = 1
Potential         = 10000.0*( ((-x)>5.0?1:0) + ((x-5.0)>0?1:0) )
PotentialDerivativeX = 0.0
UseDirectSolve    = 0
TargetEigenvalue  = 0.0
NBoundStates      = 3
NBoundStatesSave  = 1
EnablePropagation = 0
EnableCAP         = 0
Polarization      = x
